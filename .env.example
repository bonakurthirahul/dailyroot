# Copy this file to `.env` and replace the placeholders with your own values.
# NEVER commit a real .env file or any secret keys.

# Public Supabase project URL (safe to expose in the browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon / publishable key (safe to expose in the browser, protected by RLS)
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Optional: newer Supabase projects call this a publishable key (`sb_publishable_...`).
# If set, it is used only when VITE_SUPABASE_ANON_KEY is missing.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: public base URL embedded in generated table QR codes.
# Leave unset in development so QR codes point at the current origin (localhost).
# Set this to your live domain before printing production QR codes.
# VITE_PUBLIC_APP_URL=https://order.your-cafe.example

# ---------------------------------------------------------------------------
# DO NOT add the service-role or secret key here. They bypass row-level security
# and must never be shipped to a browser bundle. Use them only in trusted
# server-side contexts.
# ---------------------------------------------------------------------------
